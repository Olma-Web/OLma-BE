    {
      "id": 10,
      "title": "Request Volume",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"request completed\" |~ \"path=/v1/\" [$__interval]))",
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "title": "Error Volume",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |~ \"status=4[0-9][0-9]\" |~ \"path=/v1/\" [$__interval]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |~ \"status=5[0-9][0-9]\" |~ \"path=/v1/\" [$__interval]))",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Demo Milestone Events",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"user signed up\" [$__interval]))",
          "legendFormat": "signups"
        },
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"rate submission created\" [$__interval]))",
          "legendFormat": "rate submissions"
        },
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"estimate saved\" [$__interval]))",
          "legendFormat": "saved estimates"
        },
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"community post created\" [$__interval]))",
          "legendFormat": "community posts"
        },
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"community comment created\" [$__interval]))",
          "legendFormat": "community comments"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "Recent Failed Requests",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "{container=\"olma-backend\"} |~ \"status=[45][0-9][0-9]\" |~ \"path=/v1/\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 14,
      "title": "Core Demo API Request Logs",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "{container=\"olma-backend\"} |= \"request completed\" |~ \"path=/v1/(auth|submissions|estimates|community)\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 15,
      "title": "Business Event Logs",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "{container=\"olma-backend\"} |~ \"user signed up|login failed|rate submission created|rate submission project name updated|estimate saved|estimate project name updated|community post created|community post updated|community post deleted|community comment created|community comment updated|community comment deleted|user profile updated|password changed|outlier marking started|outlier marking completed|outlier marking failed\"",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 16,
      "title": "API Average Latency Trend",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olma-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"olma-backend\", method!=\"OPTIONS\", uri=~\"/v1/.*\"}[5m])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"olma-backend\", method!=\"OPTIONS\", uri=~\"/v1/.*\"}[5m]))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 17,
      "title": "API Average Latency by Endpoint",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "olma-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"olma-backend\", method!=\"OPTIONS\", uri=~\"/v1/.*\"}[5m])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"olma-backend\", method!=\"OPTIONS\", uri=~\"/v1/.*\"}[5m]))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "align": "auto",
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "method": "Method",
              "uri": "URI",
              "Value": "Avg latency"
            }
          }
        }
      ]
    }
  ]
}
