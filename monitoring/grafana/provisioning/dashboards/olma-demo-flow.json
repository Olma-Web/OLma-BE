{
  "title": "OLma Demo Flow",
  "uid": "olma-demo-flow",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total API Requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |= \"request completed\" |~ \"path=/v1/\" [$__range]))",
          "legendFormat": "requests"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "4xx Errors",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "olma-loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=\"olma-backend\"} |~ \"status=4[0-9][0-9]\" |~ \"path=/v1/\" [$__range]))",
