{
  "title": "OLma Logs",
  "uid": "olma-logs",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "log_source",
        "type": "custom",
        "label": "Log Source",
        "query": "olma-backend : container=\"olma-backend\",caddy : job=\"caddy\",syslog : job=\"syslog\"",
        "current": {
          "text": "olma-backend",
          "value": "container=\"olma-backend\""
        },
        "options": [
          { "text": "olma-backend", "value": "container=\"olma-backend\"", "selected": true },
          { "text": "caddy",        "value": "job=\"caddy\"",              "selected": false },
          { "text": "syslog",       "value": "job=\"syslog\"",             "selected": false }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "olma-loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({$log_source}[$__interval]))",
          "legendFormat": "logs/interval"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20 },
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      },
      "options": { "tooltip": { "mode": "single" } }
    },
    {
      "id": 2,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 22 },
      "datasource": { "type": "loki", "uid": "olma-loki" },
      "targets": [
        {
          "expr": "{$log_source}",
          "legendFormat": ""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    }
  ]
}
